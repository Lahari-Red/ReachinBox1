# ── Server ────────────────────────────────────────────────
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string

# ── Infra (matches docker-compose.yml) ───────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ── Google OAuth (same client id as frontend VITE_GOOGLE_CLIENT_ID) ──
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ── Slack OAuth app (scope: incoming-webhook) ────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must be registered in the Slack app's "Redirect URLs" — Slack requires HTTPS,
# so expose the backend with ngrok/cloudflared for local testing.
SLACK_REDIRECT_URI=https://<your-tunnel>/api/slack/callback

# ── Ethereal senders ─────────────────────────────────────
# Either list existing accounts (user:pass, comma separated)…
ETHEREAL_ACCOUNTS=
# …or leave empty and N accounts are auto-created on first boot and stored in Postgres.
ETHEREAL_SENDER_COUNT=3

# ── Throughput & rate limiting ───────────────────────────
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
DEFAULT_CAMPAIGN_HOURLY_LIMIT=100
MAX_SEND_ATTEMPTS=3
# true = worker runs inside the API process; false = run `npm run start:worker` separately
RUN_WORKER_IN_API_PROCESS=true

# ── Optional basic auth for /admin/queues ────────────────
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
